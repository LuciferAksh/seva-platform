# Demo works without any accounts or keys; all demo state is browser-local.
VITE_APP_MODE=demo
VITE_API_BASE_URL=http://localhost:8000
# To connect real services set VITE_APP_MODE=connected and all public values below.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_TURNSTILE_SITE_KEY=
# Never add service-role, Groq, Brevo or Turnstile secret keys to VITE_* variables.
